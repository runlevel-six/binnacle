# EditorConfig provides formatting hints to editors and IDEs.
# https://editorconfig.org
#
# This is for convenience, not enforcement — gofmt and golangci-lint are the
# authority on Go style, since they understand when a line genuinely can't be
# broken up.

root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
max_line_length = 120

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yaml,yml}]
indent_size = 2

[*.md]
max_line_length = 120

[*.{bash,sh}]
indent_size = 4
